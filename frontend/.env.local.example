# Optional: Copy this file to .env.local to override environment variables
# .env.local overrides .env and npm script variables for local development

# API Backend URL (optional override)
# For development with separate backend server:
# VITE_API_BASE_URL=http://localhost:8080/api/v1
#
# For production builds or running against integrated backend:
# VITE_API_BASE_URL=/api/v1

# Note: MSW mocking is now controlled via npm scripts:
# - npm run dev         (with MSW mocks)
# - npm run dev:local   (without mocks, uses real backend)
#
# You can still override VITE_USE_MOCKS here if needed:
# VITE_USE_MOCKS=false
